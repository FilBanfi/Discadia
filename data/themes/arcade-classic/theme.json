    "selection_glow": true,
    "scanline_overlay": false,
    "crt_curve": false,
    "frame_overlay": ""
  },
  "sounds": {
    "enabled": true,
    "volume": 0.7
  },
  "metadata_display": {
    "show_platform": true,
    "show_year": true,
    "show_publisher": true,
    "show_developer": true,
    "show_genre": true,
    "show_players": true,
    "show_version": true,
    "show_region": true,
    "separator": " • "
