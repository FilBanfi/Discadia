{
  "name": "Arcade Classic",
  "author": "Discadia Team",
  "version": "1.0",
  "description": "Stile cabinato arcade anni '90",
  "colors": {
    "background": "#1a1a2e",
    "background_gradient_end": "#16213e",
    "primary": "#e94560",
    "secondary": "#0f3460",
    "text": "#ffffff",
    "text_secondary": "#a0a0a0",
    "accent": "#f5a623",
    "selection_glow": "#f5a623"
  },
  "fonts": {
    "title": "",
    "body": "",
    "small": ""
  },
  "sizes": {
    "icon_normal": 180,
    "icon_selected": 240,
    "icon_spacing": 220,
    "icon_border_radius": 8,
    "title_size": 56,
    "description_size": 22,
    "meta_size": 18,
    "top_bar_height": 80,
    "metadata_panel_height": 200
  },
  "layout": {
    "icons_y_position": 0.55,
    "title_y_position": 0.12,
    "description_y_position": 0.78,
    "meta_y_position": 0.88,
